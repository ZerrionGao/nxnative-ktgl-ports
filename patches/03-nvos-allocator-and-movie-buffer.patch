    把游戏的图形分配器装进 NvOs，并接受 SDK 1.6 非 const 的影片缓冲访问
    
    只在宿主记下分配器时，影片解复用会在空指针上构造消息；这份 SDK 的 Buffer 访问也不是 const。

diff --git a/dm/gfx/hle_nv.c b/dm/gfx/hle_nv.c
index 9e80d1c4..f09f129f 100644
--- a/dm/gfx/hle_nv.c
+++ b/dm/gfx/hle_nv.c
@@ -11,8 +11,17 @@ struct nv_allocator g_nv_alloc, g_nv_devtools_alloc;
 static struct { void *mem; unsigned long size; int inited; } g_nv_pool;
 
 #define WHY "NVN has been replaced wholesale with a host null device, so the driver glue layer has nothing to do"
-HLE_FORCE("_ZN2nv20SetGraphicsAllocatorEPFPvmmS0_EPFvS0_S0_EPFS0_S0_mS0_ES0_", WHY "; allocator recorded in g_nv_alloc",
-          void, h_nv_SetAlloc, nv_alloc_fn a, nv_free_fn f, nv_realloc_fn r, void *u) { g_nv_alloc = (struct nv_allocator){a, f, r, u}; }
+// The module's own SetGraphicsAllocator is what installs these callbacks as NvOs's allocator. Recording them only on the host leaves NvOs on its default heap, which grows through
+// nn::os::AllocateMemoryBlock. That fails once the game has taken the process heap, operator new returns null, and the caller still constructs on it (the movie player's AMessage).
+static void nv_install_guest(const char *sym, nv_alloc_fn a, nv_free_fn f, nv_realloc_fn r, void *u) {
+    void (*orig)(nv_alloc_fn, nv_free_fn, nv_realloc_fn, void *) = guest_sym(sym);
+    if (orig) orig(a, f, r, u);
+}
+HLE_FORCE("_ZN2nv20SetGraphicsAllocatorEPFPvmmS0_EPFvS0_S0_EPFS0_S0_mS0_ES0_", WHY "; allocator recorded in g_nv_alloc and installed in the guest module",
+          void, h_nv_SetAlloc, nv_alloc_fn a, nv_free_fn f, nv_realloc_fn r, void *u) {
+    g_nv_alloc = (struct nv_allocator){a, f, r, u};
+    nv_install_guest("_ZN2nv20SetGraphicsAllocatorEPFPvmmS0_EPFvS0_S0_EPFS0_S0_mS0_ES0_", a, f, r, u);
+}
 HLE_FORCE("_ZN2nv28SetGraphicsDevtoolsAllocatorEPFPvmmS0_EPFvS0_S0_EPFS0_S0_mS0_ES0_", WHY "; allocator recorded in g_nv_devtools_alloc",
           void, h_nv_SetDevAlloc, nv_alloc_fn a, nv_free_fn f, nv_realloc_fn r, void *u) { g_nv_devtools_alloc = (struct nv_allocator){a, f, r, u}; }
 HLE_FORCE("_ZN2nv18InitializeGraphicsEPvm", WHY "; pool recorded for nv::GetGraphicsMemoryInfo", void, h_nv_Init, void *mem, unsigned long size) {
