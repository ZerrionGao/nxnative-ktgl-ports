     static size_t (*orig)(const uint8_t *); if (!orig) orig = gsym("_ZN2nn5audio30GetAudioRendererWorkBufferSizeERKNS0_22AudioRendererParameterE");
     uint8_t p[P_SIZE]; cpu_manual(p, param); size_t n = orig(p);
     size_t service = *(int32_t *)(param + P_DEVICE) == 0 ? ar_service_work_size(p) : 0;
@@ -152,7 +170,57 @@ static void *rev_find(void *obj) {
     for (int i = 0; i < 4 && !ev; i++) if (g_rev[i].obj == obj) ev = g_rev[i].ev;
     pthread_mutex_unlock(&g_rev_mu); return ev;
 }
+// No in-process renderer: do not call the SDK open (it connects to audren:u and Breaks). The handle is a stand-in the later calls never dereference.
+// The game waits on the event it passed (WaitSystemEvent, no timeout), so a host thread signals the bound auto-clear event every 5 ms.
+static uint8_t g_silent_obj[0x20] __attribute__((aligned(16)));
+static void *g_pulse_ev;
+static _Atomic int g_pulse_run;
+static pthread_t g_pulse_th;
+static int g_pulse_live;
+static pthread_mutex_t g_pulse_mu = PTHREAD_MUTEX_INITIALIZER;
+static void *ar_pulse(void *arg) {
+    (void)arg;
+    while (atomic_load(&g_pulse_run)) {
+        void *ev = g_pulse_ev;
+        if (ev) hle_signal_bound_system_event(ev);
+        usleep(5000);
+    }
+    return NULL;
+}
+static void ar_pulse_stop(void) {
+    pthread_mutex_lock(&g_pulse_mu);
+    int live = g_pulse_live; pthread_t th = 0;
+    if (live) { atomic_store(&g_pulse_run, 0); th = g_pulse_th; }
+    pthread_mutex_unlock(&g_pulse_mu);
+    if (!live) return;
+    pthread_join(th, NULL);
+    pthread_mutex_lock(&g_pulse_mu); g_pulse_live = 0; g_pulse_ev = NULL; pthread_mutex_unlock(&g_pulse_mu);
+}
+static void ar_pulse_start(void *ev) {
+    pthread_mutex_lock(&g_pulse_mu);
+    g_pulse_ev = ev;
+    if (!g_pulse_live) {
+        atomic_store(&g_pulse_run, 1);
+        if (pthread_create(&g_pulse_th, NULL, ar_pulse, NULL)) {
+            atomic_store(&g_pulse_run, 0); g_pulse_ev = NULL;
+            pthread_mutex_unlock(&g_pulse_mu);
+            LOG("[RED] audren: cannot start the renderer event thread");
+            return;
+        }
+        g_pulse_live = 1;
+    }
+    pthread_mutex_unlock(&g_pulse_mu);
+}
+static Result ar_open_silent(void **handle, void *ev, const uint8_t *param, void *work, size_t sz) {
+    if (handle) { handle[0] = g_silent_obj; handle[1] = NULL; }
+    static int once;
+    if (!once++) LOG("audren: OpenAudioRenderer answered locally (no in-process renderer); sound stays silent. rate %d voices %d work %p+%#zx",
+        param ? *(const int32_t *)param : 0, param ? *(const int32_t *)(param + 0x10) : 0, work, sz);
+    if (ev) { hle_bind_system_event(ev, 1); ar_pulse_start(ev); }
+    return RES_OK;
+}
 static Result ar_open(void **handle, void *ev, const uint8_t *param, void *work, size_t sz) {
+    if (!ar_cpu_renderer()) return ar_open_silent(handle, ev, param, work, sz);
     static Result (*orig_ev)(void **, void *, const uint8_t *, void *, size_t), (*orig)(void **, const uint8_t *, void *, size_t);
     if (!orig_ev) orig_ev = gsym("_ZN2nn5audio17OpenAudioRendererEPNS0_19AudioRendererHandleEPNS_2os11SystemEventERKNS0_22AudioRendererParameterEPvm");
     if (!orig) orig = gsym("_ZN2nn5audio17OpenAudioRendererEPNS0_19AudioRendererHandleERKNS0_22AudioRendererParameterEPvm");
@@ -208,6 +276,7 @@ HLE_FORCE("_ZN2nn5audio17OpenAudioRendererEPNS0_19AudioRendererHandleEPNS_2os11S
 HLE_FORCE("_ZN2nn5audio17OpenAudioRendererEPNS0_19AudioRendererHandleERKNS0_22AudioRendererParameterEPvm", "open the renderer (no event): CPU rendering + manual execution, the host starts a render thread",
           Result, h_ar_Open0, void **handle, const uint8_t *param, void *work, size_t sz) { return ar_open(handle, NULL, param, work, sz); }
 HLE_FORCE("_ZN2nn5audio18CloseAudioRendererENS0_19AudioRendererHandleE", "close the renderer: stop the host render thread first, then hand over to the SDK", void, h_ar_Close, void *obj, void *state) {
+    if (!ar_cpu_renderer()) { ar_pulse_stop(); return; }   // the SDK close would load the stand-in handle and Break in the same audren:u client
     static void (*orig)(void *, void *); if (!orig) orig = gsym("_ZN2nn5audio18CloseAudioRendererENS0_19AudioRendererHandleE");
     // Join the render thread first (it checks g_open every round and at most every 10 ms while waiting for the output): it may be inside exec(), which uses the renderer the SDK is about to free.
     // A fixed 20 ms sleep used to stand in for this, and a renderer reopened inside that window ran a second thread over the first one's static buffers
@@ -220,6 +289,26 @@ HLE_FORCE("_ZN2nn5audio18CloseAudioRendererENS0_19AudioRendererHandleE", "close
         destroy(sev); rev_set(sev, NULL);
     }
 }
+// Start, Stop and RequestUpdate on an SDK with a renderer are the SDK's own (16-byte handle in x0/x1, the config in x2). Without one, the SDK copies load the
+// stand-in and send to audren:u, then Break; the game only checks the result (無双OROCHI２ Ultimate main+0x5eb3d4, main+0x5ebae0).
+HLE_FORCE("_ZN2nn5audio18StartAudioRendererENS0_19AudioRendererHandleE", "start the renderer: the SDK's own when it has one, success without audren:u when it does not",
