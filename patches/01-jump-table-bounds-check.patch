-    if cmp and changed: return None   # the index changes after the check. Before a check it does not matter, so this waits for the walk to find one
+    if cmp and changed:
+        # The compare the walk reached does not bound this load: the index was reloaded, then copied, then checked again beside the load
+        # (無双OROCHI２ Ultimate main+0x1bb31c: cmp w18,#3; b.hs; ldr w18,[x20,#0xc]; mov w0,w18; cmp w18,#3; b.hi; ldrsw x18,[x16,x0,lsl #2]).
+        # Drop it only on the last attempt, which then reads the check next to the load. An earlier attempt still fails the site, so a table recognized before stays as it was
+        if not copy_first: return None
+        cmp = None
     if not cmp and copy_first: cmp = check_before_copy(insl, ctx, ld, idx | copies)
     if not cmp: return None
     n = int(cmp.op_str.split('#')[1], 0) + 1
diff --git a/dm/tools/tests/test_jump_copies.py b/dm/tools/tests/test_jump_copies.py
index fc7667ca..4d2f8a19 100644
--- a/dm/tools/tests/test_jump_copies.py
+++ b/dm/tools/tests/test_jump_copies.py
@@ -220,6 +220,22 @@ class IndexChangedAfterCheck(unittest.TestCase):
         ins = list(md.disasm(struct.pack('<' + 'I' * len(words), *words), 0))
         self.assertEqual(scope['jump_offsets'](ins, 8, copy_first=True), targets)
 
+    def test_a_reloaded_index_uses_the_check_beside_the_load(self):
+        # cmp w18,#7; b.hs; ldr w18,[x20,#0xc]; mov w0,w18; cmp w18,#3; b.hi; ldrsw x18,[x16,x0,lsl #2]
+        # The walk follows w0 back to w18, then meets the reload and the earlier compare. That compare is not this table.
+        words = [ADRP(16, 0, self.TABLE), ADDI(16, 16, self.TABLE & 0xfff), 0x7100001f | 7 << 10 | 18 << 5, 0x540001a2,
+                 0xb9400e92, mov(0, 18, False), 0x7100001f | 3 << 10 | 18 << 5, bhi(28, 64),
+                 0xb8a07800 | 16 << 5 | 18, ADDR(18, 18, 16), BR(18)] + [RET] * 5
+        targets = [44 + i * 4 for i in range(4)]
+        for i, target in enumerate(targets): struct.pack_into('<i', IMG, self.TABLE + 4 * i, target - self.TABLE)
+        struct.pack_into('<i', IMG, self.TABLE + 16, 0x1000)   # an eighth entry the stale compare would read
+        md = Cs(CS_ARCH_ARM64, CS_MODE_ARM); md.detail = True
+        ins = list(md.disasm(struct.pack('<' + 'I' * len(words), *words), 0))
+        self.assertEqual(len(ins), len(words))
+        j = next(i for i, p in enumerate(ins) if p.mnemonic == 'br')
+        self.assertIsNone(scope['jump_offsets'](ins, j))
+        self.assertEqual(scope['jump_offsets'](ins, j, copy_first=True, far_base=True), targets)
+
 
